{
  "name": "gh-pages-demo",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "gh-pages": "^6.3.0",
    "json-server": "^0.17.4",
    "node-fs": "^0.1.7",
    "shx": "^0.3.4",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "serve": "json-server --watch ./src/server/db/index.js --routes ./src/server/routes.json --port 3001",
    "save-json-api": "node ./src/server/scripts/save-json-api.js",
    "build": "react-scripts build && npm run save-json-api && shx cp build/index.html build/404.html",
    "predeploy": "shx rm -rf build && npm run build",
    "deploy": "gh-pages -d build"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
